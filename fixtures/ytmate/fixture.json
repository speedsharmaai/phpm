{
  "name": "speedsharma/ytmate",
  "description": "AI growth studio for YouTube creators. Plain PHP on Hostinger.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "ext-sodium": "*",
    "ext-mbstring": "*",
    "ext-gd": "*",
    "guzzlehttp/guzzle": "^7.9",
    "aws/aws-sdk-php": "^3.300"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "Ytmate\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Ytmate\\Tests\\": "tests/" }
  },
  "config": {
    "platform": { "php": "8.2.0" },
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "serve": "php -S 127.0.0.1:8080 -t public_html public_html/router.php",
    "worker": "php cron/worker.php",
    "scheduler": "php cron/scheduler.php",
    "migrate": "php bin/migrate.php"
  }
}
