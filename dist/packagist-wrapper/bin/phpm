#!/usr/bin/env php
<?php

declare(strict_types=1);

use Speedsharma\Phpm\Installer;

$root = dirname(__DIR__);

foreach ([$root . '/vendor/autoload.php', $root . '/../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

$version = Installer::packageVersion("$root/composer.json");
$binaryPath = Installer::ensureInstalled($root, $version);

exit(Installer::run($binaryPath, array_slice($argv, 1)));
